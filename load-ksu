#!/bin/bash
# load-ksu: Load KernelSU kernel module for Waydroid
#
# Uses modloader (not insmod) to resolve symbols at runtime.
# This is required on kernels with LTO (e.g. CachyOS bore-lto)
# where internal symbols are not exported to modules.
set -eu

RED='\e[1;31m'
GREEN='\e[1;32m'
BLUE='\e[1;34m'
YELLOW='\e[1;33m'
RESET='\e[0m'

if [[ ${EUID} != 0 ]]; then
  echo -e "${RED}[!] Please run as root!${RESET}"
  exit 1
fi

if ! command -v modloader &>/dev/null; then
  echo -e "${RED}[!] modloader not found. Reinstall with install.sh${RESET}"
  exit 1
fi

echo -e "${BLUE}[*] Loading KernelSU module...${RESET}"

# unload first if already loaded
if lsmod | grep -q kernelsu; then
  rmmod kernelsu 2>/dev/null || true
fi

# find the module (try modinfo first, then manual search)
KVERSION=$(uname -r)
KSU_MODULE=$(modinfo kernelsu 2>/dev/null | grep filename | awk '{print $2}') || true
[ -n "$KSU_MODULE" ] || KSU_MODULE=$(find /usr/lib/modules/"$KVERSION"/{updates,extras} -iname 'kernelsu.ko*' 2>/dev/null | head -1)
[ -n "$KSU_MODULE" ] || KSU_MODULE=$(find /lib/modules/"$KVERSION"/{updates,extras} -iname 'kernelsu.ko*' 2>/dev/null | head -1)

if [[ -z "${KSU_MODULE}" ]]; then
  echo -e "${RED}[!] kernelsu.ko not found for kernel '${KVERSION}'. Run the installer first.${RESET}"
  exit 1
fi

# ensure ext4 is loaded (dependency)
if ! grep -wq ext4 /proc/modules; then
  modprobe ext4 2>/dev/null || true
fi

# decompress and load via modloader
case "$KSU_MODULE" in
  *.zst) GET_CMD="zstdcat" ;;
  *.xz)  GET_CMD="xzcat" ;;
  *.gz)  GET_CMD="gzip -dc" ;;
  *)     GET_CMD="cat" ;;
esac

if $GET_CMD "$KSU_MODULE" | modloader -; then
  echo -e "${GREEN}[+] KernelSU loaded successfully${RESET}"
else
  echo -e "${RED}[!] Failed to load KernelSU module. Check dmesg.${RESET}"
  dmesg | grep -i "kernelsu" | tail -5
  exit 1
fi

# verify
if lsmod | grep -q kernelsu; then
  echo -e "${GREEN}[+] KernelSU is active!${RESET}"
else
  echo -e "${YELLOW}[!] Module loaded but not showing in lsmod. Check dmesg.${RESET}"
fi
