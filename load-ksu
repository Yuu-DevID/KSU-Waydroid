#!/bin/bash
# load-ksu: Load KernelSU kernel module for Waydroid
set -eu

RED='\e[1;31m'
GREEN='\e[1;32m'
BLUE='\e[1;34m'
YELLOW='\e[1;33m'
RESET='\e[0m'

if [[ ${EUID} != 0 ]]; then
  echo -e "${RED}[!] Please run as root!${RESET}"
  exit 1
fi

echo -e "${BLUE}[*] Loading KernelSU module...${RESET}"

# try modprobe first
if modprobe kernelsu 2>/dev/null; then
  echo -e "${GREEN}[+] KernelSU loaded via modprobe${RESET}"
else
  # fallback: find and insmod manually
  KO_PATH="$(find /lib/modules /usr/lib/modules -name 'kernelsu.ko' 2>/dev/null | head -1)"
  if [[ -n "${KO_PATH}" ]]; then
    insmod "${KO_PATH}"
    echo -e "${GREEN}[+] KernelSU loaded from: ${KO_PATH}${RESET}"
  else
    echo -e "${RED}[!] kernelsu.ko not found. Run the installer first.${RESET}"
    exit 1
  fi
fi

# verify
if lsmod | grep -q kernelsu; then
  echo -e "${GREEN}[+] KernelSU is active!${RESET}"
else
  echo -e "${YELLOW}[!] Module loaded but not showing in lsmod. Check dmesg.${RESET}"
fi
